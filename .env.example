# Password to access the site (choose a strong one).
APP_PASSWORD=change-me

# Random long secret used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-too

# Anthropic API key, used by the AI health assistant.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the assistant.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: where the JSON data file is stored (defaults to ./data).
# DATA_DIR=./data

# Set to "true" only if the site is served over HTTPS (e.g. behind Caddy/Nginx
# with a real certificate). Leave unset/false for plain-HTTP private deployments
# (home network, Tailscale/VPN) — otherwise the login cookie will never be sent.
# COOKIE_SECURE=true
